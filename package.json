{
    "name": "windy-plugin-spotlog",
    "version": "0.18.5",
    "description": "Spotlog: session diary for Windy",
    "main": "dist/plugin.min.js",
    "type": "module",
    "scripts": {
        "build": "rm -rf dist && mkdir dist && SERVE=false rollup -c && cp package.json dist/",
        "build:win": "rmdir /s /q dist && mkdir dist && set SERVE=false && rollup -c && copy package.json dist\\",
        "start": "rollup -w -c",
        "sandbox": "npm run build && python3 harness/assemble.py && python3 -m http.server 8765",
        "lab": "npm run build && node scripts/build-lab.mjs",
        "apply-design": "node scripts/apply-design.mjs",
        "check-words": "python3 scripts/check-words.py",
        "lint": "eslint --ext .ts,.svelte src",
        "publish:windy": "./scripts/publish.sh",
        "package:windy": "node scripts/package-plugin.mjs",
        "test:package": "node scripts/test-package.mjs",
        "test:e2e": "python3 harness/e2e.py /tmp",
        "test:predict": "node scripts/test-predict.mjs",
        "check": "npm run check:fast && npm run build",
        "test:scenarios": "python3 harness/scenarios.py /tmp",
        "test:core": "node scripts/test-core.mjs",
        "test:services": "node scripts/test-services.mjs",
        "check:types": "svelte-check --workspace . --threshold warning",
        "check:version": "node scripts/check-version.mjs",
        "check:fast": "npm run lint && npm run check-words && npm run check:version && npm run check:types && npm run test:core && npm run test:predict && npm run test:learning && npm run test:services",
        "rebuild:harness": "python3 harness/assemble.py && node scripts/build-lab.mjs",
        "check:browser": "python3 harness/e2e.py /tmp/spotlog-e2e && python3 harness/scenarios.py /tmp/spotlog-scenarios && python3 harness/regressions.py /tmp/spotlog-regressions && npm run test:learning:browser",
        "test:learning": "node scripts/test-learning-scenarios.mjs",
        "test:learning:browser": "python3 harness/learning_scenarios.py"
    },
    "author": "Sophia Stoltz",
    "license": "ISC",
    "dependencies": {
        "@windycom/plugin-devtools": "^3.0.3"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "15.3.1",
        "@rollup/plugin-commonjs": "25.0.8",
        "@rollup/plugin-terser": "0.4.4",
        "rollup": "4.63.5",
        "rollup-plugin-serve": "1.1.1",
        "rollup-plugin-svelte": "7.2.3",
        "rollup-plugin-swc3": "0.11.2",
        "less": "4.9.1",
        "svelte-preprocess-less": "0.4.0",
        "svelte-preprocess": "5.1.4",
        "svelte": "4.2.20",
        "typescript": "5.9.3",
        "eslint": "8.57.1",
        "@typescript-eslint/eslint-plugin": "6.21.0",
        "@typescript-eslint/parser": "6.21.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-import-resolver-typescript": "3.10.1",
        "svelte-eslint-parser": "0.43.0",
        "svelte-check": "3.8.6",
        "@types/node": "^20.0.0",
        "@cloudflare/workers-types": "^4.0.0",
        "postcss": "8.5.28",
        "postcss-selector-parser": "6.1.4"
    },
    "engines": {
        "node": ">=20"
    }
}
